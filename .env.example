# Скопируйте в .env.local и подставьте свой ключ. .env.local в git не попадает.
OPENAI_API_KEY=

# Базовая модель — фолбэк, если специальные не заданы.
OPENAI_MODEL=gpt-4o-mini
# Разбор расклада (это товар — модель помощнее).
OPENAI_READING_MODEL=gpt-4.1
# Диалог с AI-тарологом (частый и болтливый — дешёвой достаточно).
OPENAI_CHAT_MODEL=gpt-4.1-mini

# --- База данных (Postgres). Локально: docker compose up -d ---
DATABASE_URL=postgres://taro:taro@localhost:5432/taro

# --- Оплата (ЮKassa). Без этих ключей пополнение баланса отключено. ---
# shopId и секретный ключ из личного кабинета ЮKassa.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Базовый URL сайта для return_url и вебхука (напр. https://tarvenai.com).
# Если не задан — берётся из входящего запроса.
APP_URL=

# В личном кабинете ЮKassa указать URL вебхука:
#   https://<домен>/api/payments/yookassa-webhook
# и включить события payment.succeeded и payment.canceled.
