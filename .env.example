# Скопируйте в .env.local и подставьте свой ключ. .env.local в git не попадает.
OPENAI_API_KEY=

# Базовая модель — фолбэк, если специальные не заданы.
OPENAI_MODEL=gpt-4o-mini
# Разбор расклада (это товар — модель помощнее).
OPENAI_READING_MODEL=gpt-4.1
# Диалог с AI-тарологом (частый и болтливый — дешёвой достаточно).
OPENAI_CHAT_MODEL=gpt-4.1-mini

# --- База данных (Postgres). Локально: docker compose up -d ---
DATABASE_URL=postgres://taro:taro@localhost:5432/taro
